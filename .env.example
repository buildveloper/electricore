# Public site URL, used for canonical links, sitemap and social previews.
# Replace with the real domain once it is purchased.
# An absolute URL is required: a blank value (or a value with no scheme, such
# as "electricorellc.com") falls back to the placeholder domain rather than
# failing the build.
NEXT_PUBLIC_SITE_URL=https://electricorellc.com

# ---------------------------------------------------------------------------
# Lead delivery
# ---------------------------------------------------------------------------
# The quote form always validates and logs leads server-side. Configure any of
# the channels below to also deliver leads off-site. All of them are optional:
# with none set, submissions are logged and the visitor is still offered the
# phone/mailto fallback so a lead is never silently lost.
#
# Email an entire lead to the office inbox.
# Get a key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# LEAD_TO_EMAIL=electricore247@gmail.com
# LEAD_FROM_EMAIL=ElectriCore Website <onboarding@resend.dev>

# Text message the office (Twilio).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+19105550000
# LEAD_TO_SMS=+19105842513

# Forward the raw lead payload to a CRM, Zapier, Make, or Slack webhook.
# LEAD_WEBHOOK_URL=https://hooks.example.com/xxxx
